node_modules/
.venv/
dist/
__pycache__/
*.pyc

# Session artifacts — plans, progress, proofs, and the machine-local plugin registry
.mastracode/plans/
.mastracode/plugins/
# The hub keeps the runtime's settings under its own root rather than the
# machine's shared one (client/src/hub.ts); what lands there is local state.
# Both spellings on purpose, for the same reason the clips below carry two: a
# pattern with an internal slash anchors to the repo root, and the hub resolves
# these against its own package (client/src/index.ts). The root spelling alone
# left the real file — the one carrying which voice a person picked — visible
# to `git add`.
.mastracode/settings.json
client/.mastracode/settings.json
# What this machine's owner picked, and the record of them picking it. Both are
# facts about one person's machine, and the audit is the one file here that
# would be actively wrong to publish (client/src/settings/).
.mastracode/hub-settings.json
.mastracode/settings-audit.jsonl
client/.mastracode/hub-settings.json
client/.mastracode/settings-audit.jsonl
# The secrets paired devices present at the /events door — the one file here a
# leak of which would let a stranger open a window onto this machine's spoken
# conversation. Both spellings, same anchoring trap as above.
.mastracode/device-credentials.json
client/.mastracode/device-credentials.json

# The hub's own plugin registry: derived from the allowlist on every boot
.mastracode-hub/

# The dashboard's build artifacts: `next build` re-derives them at gate and
# package time, and the gate order — build first, assert after — is what
# satisfies "the artifact a browser fetches is the artifact under test".
dashboard/out/
dashboard/.next/
dashboard/tsconfig.tsbuildinfo

# Plan copies generated for reading — never committed
/PLAN-*.md
.mastracode/*.md
.playwright-mcp/

# Widget ear assets (model weights + WASM) — reproduced by clients/widget/scripts/vendor-widget-ear.mjs
clients/widget/src/vendor/ear/
