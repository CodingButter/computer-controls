node_modules/
.venv/
dist/
__pycache__/
*.pyc

# Session artifacts — plans, progress, proofs, and the machine-local plugin registry
.mastracode/plans/
.mastracode/plugins/
# The hub keeps the runtime's settings under its own root rather than the
# machine's shared one (client/src/hub.ts); what lands there is local state.
.mastracode/settings.json
# What this machine's owner picked, and the record of them picking it. Both are
# facts about one person's machine, and the audit is the one file here that
# would be actively wrong to publish (client/src/settings/).
.mastracode/hub-settings.json
.mastracode/settings-audit.jsonl

# The hub's own plugin registry: derived from the allowlist on every boot
.mastracode-hub/

# Filler clips synthesized on this machine's boot — re-derived, never shipped
.mastracode/orb-clips/

# Plan copies generated for reading — never committed
/PLAN-*.md
.mastracode/*.md
.playwright-mcp/
